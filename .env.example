# Tesseract language data folder (enables OCR in pymupdf4llm for scanned PDFs).
# Install Tesseract, then point this at its tessdata directory.
#   Windows: winget install UB-Mannheim.TesseractOCR
#   Linux:   apt install tesseract-ocr   ->  /usr/share/tesseract-ocr/*/tessdata
#   macOS:   brew install tesseract      ->  /opt/homebrew/share/tessdata
# Leave unset to skip OCR entirely; digital-text PDFs parse fine without it.
TESSDATA_PREFIX=
